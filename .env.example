# =====================================================================
# SupplyPilot — environment variable template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =====================================================================

# PostgreSQL connection string from Supabase.
# Format: postgresql://postgres:<password>@<host>:<port>/<database>
# Find this in: Supabase → Project Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:your_db_password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# API key for the Groq hosted inference API (LLM provider).
# Obtain from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# API key for OpenWeatherMap (free tier, 5-day forecast).
# Obtain from: https://openweathermap.org/api → My API Keys
# Note: new keys can take up to 2 hours to activate after creation.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Base URL of the FastAPI backend.
# Locally: http://localhost:8000
# In production: set to your deployed Render service URL.
BACKEND_URL=http://localhost:8000
